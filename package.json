{
  "name": "pr-report",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -C viewer dev",
    "tools": "pnpm -C viewer install --frozen-lockfile && node viewer/node_modules/typescript/bin/tsc -p tsconfig.tools.json",
    "build": "pnpm run tools && node dist/tools/scripts/build-skill.mjs",
    "deploy": "pnpm run tools && node dist/tools/scripts/deploy.mjs",
    "check": "pnpm run build && node dist/tools/scripts/check.mjs",
    "check:browser": "pnpm run tools && node dist/tools/scripts/browser-check.mjs",
    "sample": "pnpm run build && node dist/tools/scripts/check.mjs --open",
    "notices": "pnpm run tools && node dist/tools/scripts/build-notices.mjs"
  }
}
