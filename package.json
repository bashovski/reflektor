{
  "name": "pr-report",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -C viewer dev",
    "build": "node scripts/build-skill.mts",
    "deploy": "node scripts/deploy.mts",
    "check": "node scripts/build-skill.mts && pnpm -C viewer exec tsc -p ../tsconfig.scripts.json && node scripts/check.mts",
    "check:browser": "node scripts/browser-check.mts",
    "sample": "node scripts/check.mts --open"
  }
}
